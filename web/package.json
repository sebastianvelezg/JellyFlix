{
  "name": "jellyflix-web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Jellyflix Web: an independent web client for your own Jellyfin server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianvelezg/JellyFlix.git",
    "directory": "web"
  },
  "homepage": "https://github.com/sebastianvelezg/JellyFlix#readme",
  "bugs": "https://github.com/sebastianvelezg/JellyFlix/issues",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "media": "node scripts/make-test-media.mjs",
    "mock": "node scripts/mock-server.ts",
    "e2e": "playwright test",
    "smoke": "vitest run src/core/smoke.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@jellyfin/sdk": "^1.0.0",
    "axios": "^1.20.0",
    "fflate": "0.8.3",
    "hls.js": "^1.7.3",
    "pdfjs-dist": "5.4.149",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
