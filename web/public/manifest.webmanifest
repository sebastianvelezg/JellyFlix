{
  "id": "./",
  "name": "Jellyflix",
  "short_name": "Jellyflix",
  "description": "An independent web client for your own Jellyfin server.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["entertainment", "multimedia", "video"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Search", "url": "./#/search/", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Music", "url": "./#/music", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
