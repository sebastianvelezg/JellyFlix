# Copy this file to ".env" (same folder) and edit the copy. It is not a secret store, but it can hold an API key: do not share it.

# REQUIRED. The address of your Jellyfin server as THIS container reaches it. In Docker, when both containers share a network,
# use the container's name (http://jellyfin:8096); otherwise the IP address of the machine that runs Jellyfin.
JELLYFIN_URL=

# Optional. A Jellyfin API key (Dashboard > API keys > "+"). With it, the channels' lists of titles are refreshed by night and a Match
# checks what each person may see and has watched. A Match on phones (and so the TV app's Match) is refused without it; the rest works.
JELLYFIN_API_KEY=

# Which modules are on, separated by commas: channels, match, seerr. (Seerr is off unless you add it.)
JELLYFLIX_MODULES=channels,match

# Only for the seerr module. Seerr 3.3 or later. SEERR_URL is the address of Seerr as THIS container reaches it (http://seerr:5055);
# SEERR_API_KEY is in Seerr > Settings > General. The key stays in this container.
SEERR_URL=
SEERR_API_KEY=

# The port the container listens on (on this machine).
MODULES_PORT=8097

# Optional: the sites allowed to call it from a browser, separated by commas (for example http://192.168.1.50:8080). Empty means any,
# or none when JELLYFLIX_TRUST_PROXY is 1 (behind the web image's proxy the app and the container share an address).
JELLYFLIX_ORIGINS=

# Optional: 1 only when this container is reached through the web image's /modules/ proxy and its port is not published.
JELLYFLIX_TRUST_PROXY=
