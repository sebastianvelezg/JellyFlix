{
  "name": "jellyflix-modules",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Jellyflix Modules: an optional container with extra modules (retro TV channels, Match) for Jellyflix",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/src/main.ts",
    "dev": "node --watch server/src/main.ts",
    "test": "node --test \"server/test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "contract:sync": "node scripts/sync-contract.mjs",
    "contract:check": "node scripts/sync-contract.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  }
}
